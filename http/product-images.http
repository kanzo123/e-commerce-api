@host = http://localhost:5000@ghostId = 64b7f0f0f0f0f0f0f0f0f0f0# BEFORE YOU START (once):#   1. Put a small real photo next to this file as  http/test-image.jpg#      (easiest: copy public/uploads/couch.jpeg and paste it into the http folder, rename it).#   2. Make a fake 6 MB file for the "too big" test. Run this in the project folder:#        node -e "require('fs').writeFileSync('tmp/big.jpg', Buffer.alloc(6 * 1024 * 1024))"#      (tmp/ is in .gitignore, so this file is never committed)#   3. Run test A and test B in auth.http, then S1-S4 in products.http (this gives managerToken).#      Access tokens last 15 minutes. If a test gives 401 when you expect something else, run them again.## Run the tests below from top to bottom.### IMG1. Manager creates a product to put images on -> 201, no image yet, saves imageProductIdPOST {{host}}/api/v1/productsAuthorization: Bearer {{managerToken}}Content-Type: application/json{  "name": "photo chair",  "price": 25999,  "description": "A chair that gets pictures",  "category": "office",  "company": "marcos",  "inventory": 5}> {%    client.global.set('imageProductId', response.body.product.id)%}### -------- who may upload --------### IMG2. No token -> 401PATCH {{host}}/api/v1/products/{{imageProductId}}/imageContent-Type: multipart/form-data; boundary=WebAppBoundary--WebAppBoundaryContent-Disposition: form-data; name="image"; filename="test-image.jpg"Content-Type: image/jpeg< ./test-image.jpg--WebAppBoundary--### IMG3. Sara (normal user) -> 403PATCH {{host}}/api/v1/products/{{imageProductId}}/imageAuthorization: Bearer {{userToken}}Content-Type: multipart/form-data; boundary=WebAppBoundary--WebAppBoundaryContent-Disposition: form-data; name="image"; filename="test-image.jpg"Content-Type: image/jpeg< ./test-image.jpg--WebAppBoundary--### -------- bad requests: none of these may reach Cloudinary --------### IMG4. Product id that does not exist -> 404 "Product not found"PATCH {{host}}/api/v1/products/{{ghostId}}/imageAuthorization: Bearer {{managerToken}}Content-Type: multipart/form-data; boundary=WebAppBoundary--WebAppBoundaryContent-Disposition: form-data; name="image"; filename="test-image.jpg"Content-Type: image/jpeg< ./test-image.jpg--WebAppBoundary--### IMG5. Broken id -> 400 "Invalid value for _id"PATCH {{host}}/api/v1/products/abc/imageAuthorization: Bearer {{managerToken}}Content-Type: multipart/form-data; boundary=WebAppBoundary--WebAppBoundaryContent-Disposition: form-data; name="image"; filename="test-image.jpg"Content-Type: image/jpeg< ./test-image.jpg--WebAppBoundary--### IMG6. No file at all (normal JSON body) -> 400 'Please send an image in the form field "image"'PATCH {{host}}/api/v1/products/{{imageProductId}}/imageAuthorization: Bearer {{managerToken}}Content-Type: application/json{ "image": "this is not a file" }### IMG7. File sent under the wrong form field name ("photo") -> 400 "Unexpected file field"PATCH {{host}}/api/v1/products/{{imageProductId}}/imageAuthorization: Bearer {{managerToken}}Content-Type: multipart/form-data; boundary=WebAppBoundary--WebAppBoundaryContent-Disposition: form-data; name="photo"; filename="test-image.jpg"Content-Type: image/jpeg< ./test-image.jpg--WebAppBoundary--### IMG8. A text file -> 400 "Only JPEG, PNG and WebP images are allowed"PATCH {{host}}/api/v1/products/{{imageProductId}}/imageAuthorization: Bearer {{managerToken}}Content-Type: multipart/form-data; boundary=WebAppBoundary--WebAppBoundaryContent-Disposition: form-data; name="image"; filename="notes.txt"Content-Type: text/plainJust some text, not a picture.--WebAppBoundary--### IMG9. A GIF -> 400, same message (GIF is not on the list)PATCH {{host}}/api/v1/products/{{imageProductId}}/imageAuthorization: Bearer {{managerToken}}Content-Type: multipart/form-data; boundary=WebAppBoundary--WebAppBoundaryContent-Disposition: form-data; name="image"; filename="funny.gif"Content-Type: image/gifGIF89a pretend gif--WebAppBoundary--### IMG10. A file bigger than 5 MB -> 413 "File too large"PATCH {{host}}/api/v1/products/{{imageProductId}}/imageAuthorization: Bearer {{managerToken}}Content-Type: multipart/form-data; boundary=WebAppBoundary--WebAppBoundaryContent-Disposition: form-data; name="image"; filename="big.jpg"Content-Type: image/jpeg< ../tmp/big.jpg--WebAppBoundary--### -------- the first real answer from Cloudinary --------### IMG11. Text that PRETENDS to be a JPEG -> expected 400 "The file is not a valid JPEG, PNG or WebP image"# The label says image/jpeg, so our own check lets it through. Cloudinary looks inside the# file and should refuse it.PATCH {{host}}/api/v1/products/{{imageProductId}}/imageAuthorization: Bearer {{managerToken}}Content-Type: multipart/form-data; boundary=WebAppBoundary--WebAppBoundaryContent-Disposition: form-data; name="image"; filename="fake.jpg"Content-Type: image/jpegThis is plain text. It is not a picture at all.--WebAppBoundary--### -------- the real upload --------### IMG12. A real photo -> 200, "image" is a https://res.cloudinary.com/... link, no publicId in the answer# Then open the link in a browser, and look in Cloudinary > Assets: folder e-commerce-api/products.PATCH {{host}}/api/v1/products/{{imageProductId}}/imageAuthorization: Bearer {{managerToken}}Content-Type: multipart/form-data; boundary=WebAppBoundary--WebAppBoundaryContent-Disposition: form-data; name="image"; filename="test-image.jpg"Content-Type: image/jpeg< ./test-image.jpg--WebAppBoundary--> {%    client.global.set('firstImageUrl', response.body.product.image)%}### IMG13. Read the product -> the same link as IMG12GET {{host}}/api/v1/products/{{imageProductId}}### IMG14. The saved link really opens -> 200 (a picture)GET {{firstImageUrl}}### IMG15. Upload again (replace) as admin -> 200, a NEW link# Cloudinary > Assets: the folder must still show ONE file, because the old one was deleted.PATCH {{host}}/api/v1/products/{{imageProductId}}/imageAuthorization: Bearer {{adminToken}}Content-Type: multipart/form-data; boundary=WebAppBoundary--WebAppBoundaryContent-Disposition: form-data; name="image"; filename="test-image.jpg"Content-Type: image/jpeg< ./test-image.jpg--WebAppBoundary--> {%    client.global.set('secondImageUrl', response.body.product.image)    client.test('the link changed', function () {        client.assert(response.body.product.image !== client.global.get('firstImageUrl'))    })%}### IMG16. The normal update route cannot change the image -> 200, price changes, image stays the second linkPATCH {{host}}/api/v1/products/{{imageProductId}}Authorization: Bearer {{managerToken}}Content-Type: application/json{  "price": 30000,  "image": { "src": "https://evil.example/x.jpg", "publicId": "x" }}### -------- cleanup --------### IMG17. Admin deletes the product -> 200 {"msg":"Product removed"}# Cloudinary > Assets: the e-commerce-api/products folder must now be empty (the picture was deleted too).DELETE {{host}}/api/v1/products/{{imageProductId}}Authorization: Bearer {{adminToken}}### IMG18. Read it again -> 404 "Product not found"GET {{host}}/api/v1/products/{{imageProductId}}